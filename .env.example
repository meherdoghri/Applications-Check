# App A (4YOU)
APP_A_BASE_URL=https://cacib4you-dev.soprahronline.sopra
APP_A_USERNAME=
APP_A_PASSWORD=

# App B (S7)
APP_B_BASE_URL=https://devproj-cacib.soprahronline.sopra
APP_B_USERNAME=
APP_B_PASSWORD=

# Login selectors used in both apps (edit if needed)
LOGIN_USERNAME_SELECTOR=input[name="username"]
LOGIN_PASSWORD_SELECTOR=input[name="password"]
LOGIN_SUBMIT_SELECTOR=button[type="submit"]
LOGIN_SUCCESS_SELECTOR=

# JSON array of pages to compare.
# You can use shared path/url for both apps, or specific urlA/urlB when routes differ.
# Example (shared path):
# COMPARE_PAGES_JSON=[{"name":"Home","path":"/hra-space"}]
# Example (different routes):
# COMPARE_PAGES_JSON=[{"name":"Home","urlA":"https://app-a/home","urlB":"https://app-b/portal"}]
COMPARE_PAGES_JSON=[{"name":"Home","path":"/hra-space"}]

# Visual diff thresholds
# max different pixels ratio allowed (0.01 = 1%)
VISUAL_MAX_DIFF_RATIO=0.01
# pixel sensitivity for antialiasing/noise (0..1)
VISUAL_THRESHOLD=0.2

# Comma-separated selectors to hide before screenshot (timestamps, random ids, etc.)
IGNORE_SELECTORS=

# Browser behavior
HEADLESS=true
# Optional: use installed browser channel in corporate environments (e.g. chrome, msedge)
BROWSER_CHANNEL=chrome
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
DEFAULT_TIMEOUT_MS=30000
